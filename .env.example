# 절대 실제 비밀값을 커밋하지 마세요. 복사해서 .env.local 로 사용
# Database (managed Postgres 권장: Supabase / Neon / RDS)
DATABASE_URL="postgresql://user:password@localhost:5432/asset_manager?schema=public"

# Auth (32byte 이상 랜덤, `openssl rand -base64 32` 로 생성)
JWT_SECRET="CHANGE_ME_min_32_chars_random_string"
JWT_EXPIRES_IN="3600"

# App
NEXT_PUBLIC_APP_NAME="자산매니저"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
